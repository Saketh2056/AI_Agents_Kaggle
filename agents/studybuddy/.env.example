# Copy this file to .env (same folder) and fill in your key — OR skip this
# entirely and paste your key into the dialog the web app shows on launch.
# Get a free key at: https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY="paste-your-key-here"

# Which Gemini model the agents think with (switchable live from the UI).
STUDYBUDDY_MODEL="gemini-2.5-flash"
